# Taku Studio Environment Configuration
# Copy this file to .env and adjust variables as needed

# Taku REST API Key (Bearer token from https://dashboard.taku.cool/accounts/<id>/spaces/<space_id>/api)
TAKU_API_KEY=your_taku_api_key_here

# Base URL of Taku API
TAKU_BASE_URL=https://api.taku.cool/v1

# Studio Server Network Configuration
HOST=127.0.0.1
PORT=8765
